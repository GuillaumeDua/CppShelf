{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": ["before 6am on saturday"],
  "labels": ["dependencies"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "CPM.cmake bootstrap version pinned in csl_get_cpm()",
      "managerFilePatterns": [
        "/^cmake/csl/get_cpm\\.cmake$/"
      ],
      "matchStrings": [
        "set\\(CSL_GET_CPM_DEFAULT_VERSION\\s+\"(?<currentValue>[^\"]+)\"\\s+CACHE"
      ],
      "depNameTemplate": "cpm-cmake/CPM.cmake",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "CPMAddPackage() GitHub dependencies; Renovate has no CMake/CPM manager",
      "managerFilePatterns": [
        "/(^|/)CMakeLists\\.txt$/"
      ],
      "matchStrings": [
        "CPMAddPackage\\([^)]*?GITHUB_REPOSITORY\\s+(?<depName>[^\\s)]+)[^)]*?(?:GIT_TAG|VERSION)\\s+(?<currentValue>[^\\s)]+)"
      ],
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "doxygen release tag pinned for the documentation build",
      "managerFilePatterns": [
        "/^doc/scripts/generate_doc\\.sh$/"
      ],
      "matchStrings": [
        "DOXYGEN_RELEASE_TAG=(?<currentValue>Release_\\d+_\\d+_\\d+)"
      ],
      "depNameTemplate": "doxygen/doxygen",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^Release_(?<major>\\d+)_(?<minor>\\d+)_(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "doxygen-awesome-css release tag pinned for the documentation build",
      "managerFilePatterns": [
        "/^doc/scripts/generate_doc\\.sh$/"
      ],
      "matchStrings": [
        "DOXYGEN_AWESOME_CSS_RELEASE_TAG=(?<currentValue>v\\d\\S*)"
      ],
      "depNameTemplate": "jothepro/doxygen-awesome-css",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "zsh-in-docker release URL in Dockerfile",
      "managerFilePatterns": [
        "/^\\.devcontainer/Dockerfile$/"
      ],
      "matchStrings": [
        "github\\.com/deluan/zsh-in-docker/releases/download/v(?<currentValue>[^/]+)/zsh-in-docker\\.sh"
      ],
      "depNameTemplate": "deluan/zsh-in-docker",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "minimumReleaseAge": "3 days"
    },
    {
      "matchDepNames": ["fmtlib/fmt"],
      "groupName": "fmt (CPM)"
    },
    {
      "matchDepNames": ["catchorg/Catch2"],
      "groupName": "Catch2 (CPM)"
    },
    {
      "matchDepNames": ["cpm-cmake/CPM.cmake"],
      "groupName": "CPM.cmake bootstrap"
    }
  ]
}
